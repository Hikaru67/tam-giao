# Sao chép thành .env cho máy dev. Giá trị dưới đây khớp docker-compose.yml (chỉ dùng local).
NODE_ENV=development
LOG_LEVEL=info

# apps/api
API_PORT=3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# API_BODY_LIMIT_BYTES=1048576

# Dùng chung api + worker
DATABASE_URL=postgres://tamgiao@localhost:5433/tamgiao

# apps/api — Redis cho pub/sub chat realtime giữa các instance (BE-S6-02)
REDIS_URL=redis://localhost:6380

# Object storage (S3-compatible — local là SeaweedFS) — dùng chung api + worker (worker: job xoá ảnh eKYC)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tamgiao
S3_SECRET_ACCESS_KEY=tamgiao-local-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC_PROFILE=public-profile
S3_BUCKET_PRIVATE_KYC=private-kyc

# Rate limit HTTP theo IP (BE-S7-07): store redis (dùng REDIS_URL) | memory (chỉ dev/test, mỗi instance đếm riêng)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORE=redis
# RATE_LIMIT_GLOBAL_PER_MINUTE=600
# RATE_LIMIT_OTP_PER_MINUTE=10
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_DATA_RIGHTS_PER_HOUR=10

# Trust x-forwarded-for (chỉ bật khi API đứng sau reverse proxy của ta)
# TRUST_PROXY=false

# Khoá mã hoá dữ liệu & xác thực (api + worker) — GIÁ TRỊ DƯỚI ĐÂY CHỈ DÙNG LOCAL (chuỗi công khai, không phải bí mật).
# Môi trường thật: sinh bằng `openssl rand -base64 32` và cấp qua secret manager.
DATA_MASTER_KEYS=1:dGFtZ2lhby1sb2NhbC1kZXYtbWFzdGVyLWtleS0wMDE=
DATA_MASTER_KEY_VERSION=1
BLIND_INDEX_KEY=dGFtZ2lhby1sb2NhbC1kZXYtYmxpbmQtaW5kZXgtMDE=
AUTH_SECRET=dGFtZ2lhby1sb2NhbC1kZXYtYXV0aC1zZWNyZXQtMDE=

# Kênh gửi SMS OTP (D4 chưa chốt): console = in ra stdout, bị cấm khi NODE_ENV=production
SMS_PROVIDER=console

# eKYC (D2 chưa chốt): fake = FakeEkycProvider (luôn đạt), bị cấm khi NODE_ENV=production
EKYC_PROVIDER=fake
# Timeout mỗi lần gọi (ms), tổng số lần gọi (lần đầu + retry), backoff giữa các lần retry (ms)
EKYC_TIMEOUT_MS=10000
EKYC_MAX_ATTEMPTS=2
EKYC_BACKOFF_MS=500

# Cổng thanh toán (D3 chưa chốt): fake = FakePaymentGateway (có POST /dev/payments/fake/:orderId để giả lập),
# bị cấm khi NODE_ENV=production. Secret ký webhook dưới đây CHỈ dùng local.
# apps/worker dùng chung PAYMENT_GATEWAY + PAYMENT_WEBHOOK_SECRET cho job hoàn tiền (BE-S4-04).
PAYMENT_GATEWAY=fake
PAYMENT_WEBHOOK_SECRET=tamgiao-local-payment-webhook-secret
# URL cổng chuyển người dùng về sau khi thanh toán (deep link app)
PAYMENT_RETURN_URL=tamgiao://payments/return

# apps/worker — job xoá ảnh eKYC hết thời hạn lưu (BE-S3-06): cron 5 trường + múi giờ IANA
# KYC_MEDIA_RETENTION_CRON=0 3 * * *
# KYC_MEDIA_RETENTION_TZ=Asia/Ho_Chi_Minh

# apps/worker — job chuyển voucher quá hạn sang EXPIRED (BE-S4-05): cron 5 trường + múi giờ IANA
# VOUCHER_EXPIRY_CRON=*/15 * * * *
# VOUCHER_EXPIRY_TZ=Asia/Ho_Chi_Minh

# apps/worker — job đối soát ledger hằng ngày (BE-S4-07): cron 5 trường + múi giờ IANA
# LEDGER_RECONCILIATION_CRON=30 2 * * *
# LEDGER_RECONCILIATION_TZ=Asia/Ho_Chi_Minh

# apps/worker — push notification (BE-S7-05): expo = Expo Push API, fake = chỉ ghi nhận trong bộ nhớ (cấm ở production)
PUSH_PROVIDER=fake
# Access token Expo (tuỳ chọn, khi bật "Enhanced push security")
# EXPO_ACCESS_TOKEN=
# Observability (BE-S7-08) — api + worker. Bỏ trống SENTRY_DSN = không gửi lỗi đi đâu (no-op).
# SENTRY_DSN=https://<public-key>@<sentry-host>/<project-id>
# SENTRY_ENVIRONMENT=staging
# APP_RELEASE=<git sha>   (image Docker tự gán qua build arg)

# apps/api — GET /metrics (Prometheus) và GET /openapi.json + /docs
# METRICS_ENABLED=true
# METRICS_TOKEN=<>=16 ký tự; có giá trị thì /metrics cần Authorization: Bearer>
# OPENAPI_ENABLED=true   (mặc định bật trừ NODE_ENV=production)
# PUBLIC_API_URL=https://api.staging.example.vn

# apps/worker — cảnh báo outbox tồn đọng
# OUTBOX_BACKLOG_MAX_EVENTS=500
# OUTBOX_BACKLOG_MAX_AGE_SECONDS=300
# OUTBOX_BACKLOG_CHECK_INTERVAL_SECONDS=60
# OUTBOX_BACKLOG_REALERT_MINUTES=15

# Migration lúc deploy (apps/api src/migrate.ts, advisory lock): chờ khoá tối đa (ms)
# MIGRATION_LOCK_TIMEOUT_MS=300000
