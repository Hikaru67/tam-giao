# Cấu hình api + worker khi chạy e2e/k6 trên máy local (BE-S7-09) — trỏ tới tests/e2e/compose.yml.
# GIÁ TRỊ DƯỚI ĐÂY CHỈ DÙNG LOCAL (chuỗi công khai giống .env.example, không phải bí mật).
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3100
DATABASE_URL=postgres://tamgiao@localhost:55433/tamgiao
REDIS_URL=redis://localhost:56380
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tamgiao
S3_SECRET_ACCESS_KEY=tamgiao-local-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC_PROFILE=public-profile
S3_BUCKET_PRIVATE_KYC=private-kyc
# Seed tải đăng ký hàng trăm người dùng từ một máy: mỗi người dùng ảo gửi `x-forwarded-for` riêng để không vướng
# hạn mức OTP theo IP (5 lần/giờ/IP). Chỉ bật ở local — staging đứng sau reverse proxy thật.
TRUST_PROXY=true
# Rate limit toàn cục (BE-S7-07): seed tải gửi > 1 000 request admin từ một IP trong vài phút (duyệt 200 hồ sơ,
# ghép 100 cặp) → vượt RATE_LIMIT_GLOBAL_PER_MINUTE=600. Tắt cho lượt e2e/k6 local; muốn đo cả middleware rate limit
# thì bật lại và nâng RATE_LIMIT_GLOBAL_PER_MINUTE / RATE_LIMIT_OTP_PER_MINUTE / RATE_LIMIT_LOGIN_PER_MINUTE.
RATE_LIMIT_ENABLED=false
DATA_MASTER_KEYS=1:dGFtZ2lhby1sb2NhbC1kZXYtbWFzdGVyLWtleS0wMDE=
DATA_MASTER_KEY_VERSION=1
BLIND_INDEX_KEY=dGFtZ2lhby1sb2NhbC1kZXYtYmxpbmQtaW5kZXgtMDE=
AUTH_SECRET=dGFtZ2lhby1sb2NhbC1kZXYtYXV0aC1zZWNyZXQtMDE=
SMS_PROVIDER=console
EKYC_PROVIDER=fake
PAYMENT_GATEWAY=fake
PAYMENT_WEBHOOK_SECRET=tamgiao-local-payment-webhook-secret
PUSH_PROVIDER=fake
METRICS_ENABLED=true
