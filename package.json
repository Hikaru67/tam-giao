{
  "name": "tamgiao",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web && turbo run test:native",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:watch": "vitest --project unit",
    "dev": "turbo run dev",
    "dev:fe": "sh tools/scripts/dev-fe.sh",
    "seed:fe": "pnpm --filter @tamgiao/tools seed:fe",
    "build": "turbo run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:cov": "vitest run --project unit --coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "testcontainers": "12.2.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
