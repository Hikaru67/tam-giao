{
  "name": "@tamgiao/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc -p tsconfig.json",
    "test:native": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "0.4.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tamgiao/api-client": "workspace:*",
    "@tamgiao/contracts": "workspace:*",
    "@tamgiao/ui-core": "workspace:*",
    "@tamgiao/ui-mobile": "workspace:*",
    "@tamgiao/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.26",
    "expo-brightness": "58.0.3",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.16",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.14",
    "expo-font": "58.0.12",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-notifications": "58.1.9",
    "expo-router": "58.0.32",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-web-browser": "58.1.0",
    "nativewind": "4.2.7",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.native-test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|nativewind|react-native-css-interop))"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup-after-env.ts"
    ]
  }
}
