{
  "name": "tamgiao",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:watch": "vitest --project unit",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "node tools/scripts/not-implemented.mjs db:generate BE-S1-04",
    "db:migrate": "node tools/scripts/not-implemented.mjs db:migrate BE-S1-04",
    "test:cov": "vitest run --project unit --coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
