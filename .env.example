# Sao chép thành .env cho máy dev. Giá trị dưới đây khớp docker-compose.yml (chỉ dùng local).
NODE_ENV=development
LOG_LEVEL=info

# apps/api
API_PORT=3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# API_BODY_LIMIT_BYTES=1048576

# Dùng chung api + worker
DATABASE_URL=postgres://tamgiao@localhost:5433/tamgiao

# Object storage (S3-compatible — local là SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tamgiao
S3_SECRET_ACCESS_KEY=tamgiao-local-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC_PROFILE=public-profile
S3_BUCKET_PRIVATE_KYC=private-kyc
