{
  "name": "@tamgiao/tools",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "seed:admin": "node --env-file-if-exists=../.env --import tsx scripts/seed-admin.ts",
    "seed:fe": "node --env-file-if-exists=../.env --import tsx scripts/seed-fe.ts",
    "smoke:staging": "node --import tsx scripts/smoke-staging.ts",
    "scan:pii": "node --import tsx security/scan-pii.ts",
    "scan:bundle": "node --import tsx security/scan-bundle.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@tamgiao/config": "workspace:*",
    "@tamgiao/db": "workspace:*",
    "@tamgiao/kernel": "workspace:*",
    "@tamgiao/module-identity": "workspace:*",
    "zod": "4.6.7"
  }
}
